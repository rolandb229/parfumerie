# TATAVERNIS - Configuration d'environnement
# Copier ce fichier en .env et adapter les valeurs

# Base de données - XAMPP Local
DB_HOST=localhost
DB_NAME=tatavernis
DB_USER=root
DB_PASS=

# Site
SITE_NAME=TATAVERNIS
SITE_URL=http://localhost/parfumerie
SITE_EMAIL=contact@tatavernis.com
SITE_PHONE=0187999990

# Mode debug (false en production)
DEBUG_MODE=true

# Livraison
FREE_SHIPPING_THRESHOLD=50000
SHIPPING_COST=3000

# Devise
CURRENCY=FCFA
CURRENCY_SYMBOL=FCFA

# Paiement (à configurer)
STRIPE_PUBLIC_KEY=
STRIPE_SECRET_KEY=

# Email (optionnel)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Sessions
SESSION_TIMEOUT=1800
SESSION_NAME=tatavernis_session

# Uploads
MAX_FILE_SIZE=10485760
MAX_VIDEO_SIZE=104857600
